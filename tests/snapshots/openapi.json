{
  "components": {
    "schemas": {
      "Customer": {
        "properties": {
          "customer_id": {
            "minimum": 0.0,
            "title": "Customer Id",
            "type": "integer"
          },
          "first_month": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Month"
          },
          "items_in_first_month": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Items In First Month"
          },
          "joining_month": {
            "default": "Unknown",
            "enum": [
              "Jan",
              "Feb",
              "Mar",
              "Apr",
              "May",
              "Jun",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec",
              "Unknown"
            ],
            "title": "Joining Month",
            "type": "string"
          },
          "loyalty_years": {
            "enum": [
              "0-1",
              "1-3",
              "3-5",
              "5-10",
              "10+"
            ],
            "title": "Loyalty Years",
            "type": "string"
          },
          "promotion": {
            "enum": [
              "Yes",
              "No"
            ],
            "title": "Promotion",
            "type": "string"
          },
          "region": {
            "default": "Unknown",
            "enum": [
              "Americas",
              "Asia/Pacific",
              "Europe",
              "Middle East/Africa",
              "Unknown"
            ],
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "loyalty_years",
          "promotion"
        ],
        "title": "Customer",
        "type": "object"
      },
      "CustomerReward": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "integer"
          },
          "expected_reward": {
            "title": "Expected Reward",
            "type": "number"
          },
          "predicted_spend": {
            "title": "Predicted Spend",
            "type": "number"
          },
          "tier_change_probability": {
            "title": "Tier Change Probability",
            "type": "number"
          }
        },
        "required": [
          "customer_id",
          "predicted_spend",
          "expected_reward",
          "tier_change_probability"
        ],
        "title": "CustomerReward",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NextTier": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "integer"
          },
          "feasible": {
            "title": "Feasible",
            "type": "boolean"
          },
          "first_month_needed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Month Needed"
          },
          "forecast": {
            "title": "Forecast",
            "type": "number"
          },
          "gap": {
            "title": "Gap",
            "type": "number"
          },
          "next_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Threshold"
          }
        },
        "required": [
          "customer_id",
          "forecast",
          "next_threshold",
          "gap",
          "first_month_needed",
          "feasible"
        ],
        "title": "NextTier",
        "type": "object"
      },
      "NextTierRequest": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "minItems": 1,
            "title": "Customers",
            "type": "array"
          }
        },
        "required": [
          "customers"
        ],
        "title": "NextTierRequest",
        "type": "object"
      },
      "NextTierResponse": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/NextTier"
            },
            "title": "Customers",
            "type": "array"
          }
        },
        "required": [
          "customers"
        ],
        "title": "NextTierResponse",
        "type": "object"
      },
      "PredictRequest": {
        "properties": {
          "alpha": {
            "default": 0.1,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Alpha",
            "type": "number"
          },
          "customers": {
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "minItems": 1,
            "title": "Customers",
            "type": "array"
          }
        },
        "required": [
          "customers"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
          "coverage": {
            "title": "Coverage",
            "type": "number"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "model",
          "coverage",
          "predictions"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "Prediction": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "integer"
          },
          "lower": {
            "title": "Lower",
            "type": "number"
          },
          "spend": {
            "title": "Spend",
            "type": "number"
          },
          "upper": {
            "title": "Upper",
            "type": "number"
          }
        },
        "required": [
          "customer_id",
          "spend",
          "lower",
          "upper"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "RewardRequest": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "minItems": 1,
            "title": "Customers",
            "type": "array"
          },
          "n_simulations": {
            "default": 2000,
            "maximum": 20000.0,
            "minimum": 100.0,
            "title": "N Simulations",
            "type": "integer"
          },
          "seed": {
            "default": 0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "customers"
        ],
        "title": "RewardRequest",
        "type": "object"
      },
      "RewardResponse": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/CustomerReward"
            },
            "title": "Customers",
            "type": "array"
          },
          "expected_shortfall_95": {
            "title": "Expected Shortfall 95",
            "type": "number"
          },
          "expected_total": {
            "title": "Expected Total",
            "type": "number"
          },
          "p05": {
            "title": "P05",
            "type": "number"
          },
          "p95": {
            "title": "P95",
            "type": "number"
          }
        },
        "required": [
          "expected_total",
          "p05",
          "p95",
          "expected_shortfall_95",
          "customers"
        ],
        "title": "RewardResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Loyalty spend scoring"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_text_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics Text"
      }
    },
    "/next-tier": {
      "post": {
        "operationId": "next_tier_next_tier_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NextTierRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextTierResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Next Tier"
      }
    },
    "/predict": {
      "post": {
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict"
      }
    },
    "/rewards": {
      "post": {
        "operationId": "rewards_rewards_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RewardResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rewards"
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Version Version Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version"
      }
    }
  }
}
